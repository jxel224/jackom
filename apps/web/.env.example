# Copy this file to apps/web/.env.local for local development (Next.js loads .env.local
# automatically — see apps/web/lib/env.ts for validation). Must match apps/server/.env's ports.

# The local HTTP room API (apps/server's HttpApiServer, Development Step 7A).
NEXT_PUBLIC_API_URL=http://localhost:4000

# The local WebSocket gateway (apps/server's GatewayServer, Development Step 4/7B).
NEXT_PUBLIC_WS_URL=ws://localhost:4001

# Used only to build the QR-code join link (Development Step 7B) — never sent to the server, never
# contains a session token.
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
