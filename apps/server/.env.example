# Copy this file to apps/server/.env for local development.
# apps/server/src/env.ts validates these; every one already has a safe localhost default, so
# `npm run dev` works even without an .env file — this is only needed to override something.

# Redis connection. See LOCAL_DEVELOPMENT.md for how to start Redis locally (Docker or a native
# install). REDIS_URL supports redis://user:pass@host:port if your Redis needs auth.
REDIS_URL=redis://127.0.0.1:6379

# Ports the local HTTP room API and WebSocket gateway bind to.
HTTP_API_PORT=4000
WS_GATEWAY_PORT=4001

# Comma-separated list of browser origins allowed to call the HTTP API (CORS). No wildcard is ever
# supported — an origin not on this list is rejected. Must match apps/web's actual local URL.
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# Display-only — shown in the local startup banner so you know where the frontend will be, once
# `npm run dev:web` (or the combined `npm run dev`) starts it. This process never requests it.
FRONTEND_URL=http://localhost:3000

# Optional: override the default Redis TTL (seconds) used for room state/sessions. Leave unset to
# use the existing default (see apps/server/src/persistence/config.ts).
# ROOM_TTL_SECONDS=21600
