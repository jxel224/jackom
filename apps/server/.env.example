# Copy this file to apps/server/.env for local development.
# apps/server/src/env.ts validates these; every one already has a safe localhost default, so
# `npm run dev` works even without an .env file — this is only needed to override something.

# Redis connection. See LOCAL_DEVELOPMENT.md for how to start Redis locally (Docker or a native
# install). REDIS_URL supports redis://user:pass@host:port if your Redis needs auth.
REDIS_URL=redis://127.0.0.1:6379

# Ports the local HTTP room API and WebSocket gateway bind to.
HTTP_API_PORT=4000
WS_GATEWAY_PORT=4001

# Comma-separated list of browser origins allowed to call the HTTP API (CORS). No wildcard is ever
# supported — an origin not on this list is rejected. Must match apps/web's actual local URL.
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# Display-only — shown in the local startup banner so you know where the frontend will be, once
# `npm run dev:web` (or the combined `npm run dev`) starts it. This process never requests it.
FRONTEND_URL=http://localhost:3000

# Optional: override the default Redis TTL (seconds) used for room state/sessions. Leave unset to
# use the existing default (see apps/server/src/persistence/config.ts).
# ROOM_TTL_SECONDS=21600

# PostgreSQL connection (permanent business data: Users/Games/GameOwnership/Sessions — see
# PERMANENT_BACKEND_FOUNDATION_REPORT.md). Matches docker-compose.dev.yml's `postgres` service
# defaults (`npm run dev:db`) — change if you're pointing at a different local Postgres.
DATABASE_URL=postgresql://jackom:jackom_dev_only@127.0.0.1:5432/jackom_dev?schema=public

# A separate database (NOT schema) so integration tests never touch dev data — the same docker
# compose Postgres container creates both on first startup (see docker/postgres-init/).
TEST_DATABASE_URL=postgresql://jackom:jackom_dev_only@127.0.0.1:5432/jackom_test?schema=public

# HMAC secret used only to hash session tokens before storing them (never the raw token). Generate
# a real random 32+ byte value for any non-local deployment — never reuse the placeholder below.
SESSION_TOKEN_SECRET=jackom_dev_only_session_secret_change_me

# Cookie security flags — false in local dev (plain http://localhost), must be true for any real
# deployment (https).
SESSION_COOKIE_SECURE=false
